<style>
.accordion{
    background:#123528;
    color:white;
    cursor:pointer;
    padding:22px;
    width:100%;
    border:none;
    outline:none;
    text-align:left;
    font-size:18px;
    font-weight:bold;
    border-radius:15px;
    margin-top:15px;
    transition:.3s;
}

.accordion:hover{
    background:#1c4f3b;
}

.accordion.active{
    background:#22c55e;
}

.panel{
    background:#16372b;
    color:#dbe7df;
    max-height:0;
    overflow:hidden;
    transition:max-height .4s ease;
    border-radius:0 0 15px 15px;
    margin-bottom:10px;
}

.panel p{
    padding:20px;
    line-height:1.7;
}
</style>

<script>
const accordion = document.querySelectorAll(".accordion");

accordion.forEach(item => {
    item.addEventListener("click", function(){

        this.classList.toggle("active");

        const panel = this.nextElementSibling;

        if(panel.style.maxHeight){
            panel.style.maxHeight = null;
        }else{
            panel.style.maxHeight = panel.scrollHeight + "px";
        }

    });
});
</script>
